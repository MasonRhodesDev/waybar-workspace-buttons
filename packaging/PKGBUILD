# Maintainer: Mason Rhodes <mrhodesdev@gmail.com>
#
# Split package, mirroring the Fedora spec since 1.3.0:
#   waybar-workspace-buttons  — the Waybar CFFI module (talks Hyprland IPC)
#   hyprland-workspace-zones  — the compositor plugin, ABI-locked to the
#                               exact hyprland it was built against, so it
#                               carries depends=(hyprland=<built-against>).
#                               pacman then holds a hyprland upgrade back
#                               until a matching plugin build exists; the
#                               daily pin-check cuts that rebuild release.
# hyprland-git users: install hyprland-workspace-zones-git from [mason]
# (built in lockstep with hyprland-git there) instead of this plugin.

pkgbase=waybar-workspace-buttons
pkgname=('waybar-workspace-buttons' 'hyprland-workspace-zones')
pkgver=1.3.0
pkgrel=1
arch=('x86_64')
url="https://github.com/MasonRhodesDev/waybar-workspace-buttons"
license=('MIT')
makedepends=('meson' 'gtk3' 'jq' 'hyprland>=0.56' 'pixman' 'libdrm')
source=("$pkgbase-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('8c69057519076290c5e0d1bb5580f533ced53f14a808ab41e2e08b69f5bde1ed')

build() {
  cd "$pkgbase-$pkgver"
  arch-meson build
  meson compile -C build
  arch-meson plugin plugin/build
  meson compile -C plugin/build
}

package_waybar-workspace-buttons() {
  pkgdesc="Waybar CFFI workspace-buttons module for Hyprland (per-monitor filtering, special workspace indicators)"
  # hyprland-workspace-zones is a virtual name here: satisfied by the stable
  # split package or by hyprland-workspace-zones-git from [mason].
  depends=('gtk3' 'jq' 'hyprland>=0.56' 'waybar' 'hyprland-workspace-zones')
  cd "$pkgbase-$pkgver"
  meson install -C build --destdir "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_hyprland-workspace-zones() {
  pkgdesc="Per-workspace special zones plugin for Hyprland (workspace N owns special:N)"
  # Exact pin: the plugin's API-hash guard requires the compositor build it
  # was compiled against. Version-only (no pkgrel) — same-source rebuilds
  # keep the same API hash.
  local _hlver
  _hlver=$(pacman -Q hyprland | cut -d' ' -f2 | cut -d- -f1)
  depends=("hyprland=$_hlver")
  cd "$pkgbase-$pkgver"
  meson install -C plugin/build --destdir "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
